    { "id": "drain-min",     "label": "排水 1個以上",       "kind": "drain_outlet",  "metric": "kind_count",     "op": ">=", "threshold": 1,  "severity": "error" },
    { "id": "downspout-max", "label": "竪樋 1系統30m以下",  "kind": "vertical_drain","metric": "kind_total_qty", "op": "<=", "threshold": 30, "severity": "warning" }
  ]
